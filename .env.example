# ===== 必填 =====
# Etherscan API Key（https://etherscan.io/myapikey）
ETHERSCAN_API_KEY=your_etherscan_api_key
# Telegram Bot Token（通过 @BotFather 创建）
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
# Telegram Chat ID（群组/频道 ID，负数）
TELEGRAM_CHAT_ID=your_telegram_chat_id

# ===== 链配置（可选，自动匹配主流链） =====
# 链 ID：1=Ethereum, 56=BSC, 137=Polygon, 42161=Arbitrum, 10=Optimism, 8453=Base
CHAIN_ID=1
# 链名称（留空自动匹配）
CHAIN_NAME=
# Native 代币符号（留空自动匹配，如 ETH/BNB/MATIC/AVAX）
NATIVE_SYMBOL=
# Native 代币精度（留空默认 18）
NATIVE_DECIMALS=18
# 区块浏览器 URL（留空自动匹配）
EXPLORER_BASE=

# ===== 监控参数 =====
# 轮询间隔（秒）
POLL_INTERVAL=60
# Native token 大额转账阈值（>= 此值触发告警）
NATIVE_THRESHOLD=10
# ERC20 默认大额阈值（>= 此值触发告警，token_thresholds.json 可覆盖）
ERC20_THRESHOLD=100000

# ===== API =====
# Etherscan API V2 基础 URL
ETHERSCAN_BASE_URL=https://api.etherscan.io/v2/api

# ===== 存储 =====
# SQLite 数据库目录（Railway 部署设为 /app/data）
DATA_DIR=.

# ===== 调试 =====
# DRY_RUN=true 时只打印告警不发送 Telegram
DRY_RUN=false
